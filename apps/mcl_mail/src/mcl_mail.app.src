{application, mcl_mail, [
    {description, "Async mailboxes for the Macula mesh: an agent leaves work for a citizen who is not online right now"},
    {vsn, "0.3.0"},
    {registered, [mcl_mail_sup]},
    {mod, {mcl_mail_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        %% Mesh SDK, realm identity, capabilities, health.
        mcl_om,
        %% This service's own event store (mcl_mail_store opens it).
        reckon_db,
        evoq,
        reckon_evoq,
        %% The departments, started before this app so they are up when
        %% mcl_mail_app opens the store, and capabilities/0's responders
        %% are loaded.
        guide_mailbox_lifecycle,
        project_mailboxes,
        query_mailboxes
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/macula-services/mcl-mail"}]}
]}.

%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_mail.
%%
%% Async mailboxes for the Macula mesh: an agent leaves work for a citizen who is not online right now
%%
%% An umbrella of four apps: guide_mailbox_lifecycle (CMD, one event-sourced
%% mailbox per citizen), project_mailboxes (PRJ, the letter read model in
%% barrel_docdb), query_mailboxes (QRY, get_mailbox and get_letter) and mcl_mail
%% (the service contract).

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% mcl_mail_service exports store_id/0 + data_dir/0, so mcl_om:boot/1
    %% opens the store and its evoq subscription before start/1 runs. 0.27
    %% labels the boot claim (MCL_SERVICE_NAME, MCL_BOX) and no longer brings
    %% barrel_docdb.
    {mcl_om, "~> 0.27"},
    %% Declared directly because the responders implement macula_response.
    {macula, "~> 12.0"},
    %% Declared directly because the CMD desks dispatch through evoq and the
    %% aggregate keeps its status in evoq_bit_flags.
    {evoq, "~> 1.24"},
    %% The letter read model is this service's own (mcl_om stopped bringing
    %% barrel_docdb in 0.27.0). barrel brings the erlang rocksdb binding; see
    %% the override below.
    {barrel_docdb, "~> 1.5"}
]}.

%% ⚠ ROCKSDB LINKS THE SYSTEM LIBRARY. The rocksdb binding's pre_hook would
%% otherwise compile the RocksDB it bundles, tens of minutes of CPU in every CI
%% run, image build and local test. With `-DWITH_SYSTEM_ROCKSDB=ON' it links
%% librocksdb 11.1.x, the release rocksdb 3.1.2 is written against, which no
%% distribution packages: build in macula-ci-otp-rocksdb and run on
%% macula-pq-runtime-rocksdb (both pinned by digest in lint.yml and the
%% Containerfile). Without the library the build stops at configure with
%% "Could not find RocksDB", on purpose. An override replaces the whole key, so
%% the binding's clean hooks are repeated.
{overrides, [
    {override, rocksdb, [
        {pre_hooks, [
            {clean, "rm -f priv/*.so"},
            {clean, "rm -rf _build/cmake"},
            {"(linux|darwin|solaris)", compile,
             "./do_cmake.sh -DWITH_SYSTEM_ROCKSDB=ON $ERLANG_ROCKSDB_OPTS"},
            {"(freebsd|netbsd|openbsd)", compile,
             "./do_cmake.sh -DWITH_SYSTEM_ROCKSDB=ON $ERLANG_ROCKSDB_OPTS"}
        ]}
    ]}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

{relx, [
    {release, {mcl_mail, "0.1.0"}, [guide_mailbox_lifecycle, project_mailboxes,
                                    query_mailboxes, mcl_mail, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    %% meck stands in for a desk's dispatch and the read model, so a responder
    %% test sees exactly what is handed on without a store.
    {test, [{deps, [{meck, "~> 1.2"}]}]},
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.

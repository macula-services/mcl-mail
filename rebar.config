%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_mail.
%%
%% Async mailboxes for the Macula mesh: an agent leaves work for a citizen who is not online right now
%%
%% An umbrella of four apps: guide_mailbox_lifecycle (CMD, one event-sourced
%% mailbox per citizen), project_mailboxes (PRJ, the letter read model in
%% barrel_docdb), query_mailboxes (QRY, get_mailbox and get_letter) and mcl_mail
%% (the service contract).

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% It opens no store from 0.35 on (mcl-om#10): this service declares and
    %% opens its own (mcl_mail_store). 0.27
    %% labels the boot claim (MCL_SERVICE_NAME, MCL_BOX) and no longer brings
    %% barrel_docdb.
    %% 0.28 answers `Org/info' for the service. 0.33 is the release on
    %% macula 13 (~> 13.0.1). macula 13 seals a call only to a provider that
    %% names a KEM key (`kem_advertise', off by default and off here), so this
    %% service is called in the clear as before; 13.0.1 is where seed() carries
    %% the expected_node_id every pinned-seed consumer passes.
    %% 0.33.1 refuses to boot a service that sets {mesh, required} without
    %% its realm or its pinned stations, naming each missing setting. 0.38 is
    %% the release on macula 14 (mcl-mail#5); 0.39 serves /health on the Unix
    %% socket config/sys.config.src names.
    %% 1.0 was mcl_om on macula 15, the flag day (macula-fleet#27); the floor is
    %% now 1.4, the release whose base is macula 16 (macula-codebase-checks#4),
    %% because `~> 1.0' also admits 1.3.0, which requires macula `~> 15.6'
    %% (macula-codebase-checks#14). 1.0 and not a 0.43 because `~> 0.x' takes
    %% any 0.x, so a 0.43 would have rolled the live 0.10.3 fleet on its next
    %% build; 1.0 is outside that range.
    {mcl_om, "~> 1.4"},
    %% Declared directly because the responders implement macula_response. The
    %% Naming it is what makes it stick: a looser one let rebar3 pick mcl_om
    %% 0.33 with a macula 12 it does not support. 16.0 keeps wire 1.0, so this
    %% service still speaks to every wire 1.0 box; what it adds is the
    %% revocation bound (macula#118). This service gates no overlay and issues
    %% no endorsement.
    {macula, "~> 16.0"},
    %% This service's own event store (mcl_mail_store opens it).
    {reckon_db, "~> 5.11"},
    %% Declared directly because the CMD desks dispatch through evoq and the
    %% aggregate keeps its status in evoq_bit_flags.
    {evoq, "~> 1.26"},
    %% The reckon-db adapter, chosen in config/sys.config.src.
    {reckon_evoq, "~> 2.7"},
    %% The letter read model is this service's own (mcl_om stopped bringing
    %% barrel_docdb in 0.27.0). barrel brings the erlang rocksdb binding; see
    %% the override below.
    {barrel_docdb, "~> 1.5"}
]}.

%% ⚠ ROCKSDB LINKS THE SYSTEM LIBRARY. The rocksdb binding's pre_hook would
%% otherwise compile the RocksDB it bundles, tens of minutes of CPU in every CI
%% run, image build and local test. With `-DWITH_SYSTEM_ROCKSDB=ON' it links
%% librocksdb 11.1.x, the release rocksdb 3.1.2 is written against, which no
%% distribution packages: build in macula-ci-otp-rocksdb and run on
%% macula-pq-runtime-rocksdb (both pinned by digest in lint.yml and the
%% Containerfile). Without the library the build stops at configure with
%% "Could not find RocksDB", on purpose. An override replaces the whole key, so
%% the binding's clean hooks are repeated.
{overrides, [
    {override, rocksdb, [
        {pre_hooks, [
            {clean, "rm -f priv/*.so"},
            {clean, "rm -rf _build/cmake"},
            {"(linux|darwin|solaris)", compile,
             "./do_cmake.sh -DWITH_SYSTEM_ROCKSDB=ON $ERLANG_ROCKSDB_OPTS"},
            {"(freebsd|netbsd|openbsd)", compile,
             "./do_cmake.sh -DWITH_SYSTEM_ROCKSDB=ON $ERLANG_ROCKSDB_OPTS"}
        ]}
    ]}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}},
            {elvis_style, max_function_length, #{max_length => 60}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

{relx, [
    {release, {mcl_mail, "0.4.0"}, [guide_mailbox_lifecycle, project_mailboxes,
                                    query_mailboxes, mcl_mail, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    %% meck stands in for a desk's dispatch and the read model, so a responder
    %% test sees exactly what is handed on without a store.
    {test, [{deps, [{meck, "~> 1.2"}]}]},
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
